{
  "name": "richi-route",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.12.1",
    "npm": ">=11"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "routing:prepare": "node scripts/prepare-routing-rules.mjs",
    "routing:build": "node experiments/routing/brouter-patch/build-local-rules.mjs",
    "routing:check": "node scripts/check-routing-rules.mjs",
    "routing:benchmark": "node experiments/routing/benchmark-local-rules.mjs",
    "native:setup": "node scripts/setup-native.mjs",
    "search:setup": "node scripts/setup-search.mjs",
    "search:start": "node scripts/start-search.mjs",
    "search:wasm": "PATH=\"$PWD/.cache/runtime/rust/bin:$PATH\" CARGO_HOME=\"$PWD/.cache/cargo\" cargo build --release --target wasm32-unknown-unknown --manifest-path search/wasm/Cargo.toml",
    "maps:setup": "node scripts/setup-maps.mjs",
    "maps:start": "node scripts/start-maps.mjs",
    "terrain:setup": "node scripts/setup-terrain.mjs",
    "cycling:setup": "node scripts/setup-cycling.mjs",
    "imagery:setup": "node scripts/setup-imagery.mjs",
    "imagery:save": "node scripts/save-imagery.mjs",
    "imagery:region": "node scripts/imagery-region.mjs",
    "bench:brouter:performance": "node experiments/routing/brouter-patch/build-performance.mjs",
    "bench:brouter:patch": "node experiments/routing/brouter-patch/build.mjs",
    "dev": "vite",
    "dev:local": "sh scripts/start-local.sh",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "bench:setup": "node experiments/routing/setup.mjs",
    "bench:up": "docker compose -f experiments/routing/compose.yml up -d",
    "bench:ors:up": "docker compose -f experiments/routing/compose.yml up -d --build ors",
    "bench:ors:down": "docker compose -f experiments/routing/compose.yml stop ors",
    "bench:down": "docker compose -f experiments/routing/compose.yml down",
    "bench:run": "node experiments/routing/run.mjs",
    "bench:test": "node --test experiments/routing/tests/*.test.mjs",
    "bench:check-reviewed": "node experiments/routing/check-reviewed-routes.mjs",
    "bench:probe-western": "node experiments/routing/probe-western-loop.mjs",
    "test:editor-local": "node tests/editor-local-check.mjs",
    "test:weidweg-local": "node tests/weidweg-local.mjs",
    "test:kepler-local": "node tests/kepler-cyclepath-local.mjs",
    "bench:dev": "vite --config experiments/routing/vite.config.ts",
    "bench:build": "vue-tsc --noEmit -p experiments/routing/tsconfig.json && vite build --config experiments/routing/vite.config.ts",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@protomaps/basemaps": "^5.7.2",
    "@tabler/icons-vue": "3.49.0",
    "@vue/devtools-api": "^8.2.1",
    "maplibre-gl": "^6.15.0",
    "pbf": "^5.1.2",
    "pinia": "^4.1.0",
    "pmtiles": "^4.5.0",
    "vue": "^3.5.44",
    "vuetify": "4.2.4"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "2.1.3",
    "vue-tsc": "^3.3.13"
  }
}
